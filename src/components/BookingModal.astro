---
// Interactive Court Booking Modal Component for Vortex Padel Club
---

<div class="booking-modal-backdrop" id="booking-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="booking-modal-card card-rounded" role="document">
    <!-- Modal Header -->
    <div class="modal-header">
      <div class="modal-header-titles">
        <span class="badge-pill badge-pill-neon">Instant Reservation</span>
        <h3 id="modal-title" class="title-h3 modal-main-title">Book Your Padel Court</h3>
      </div>
      <button type="button" class="btn-circle-mini modal-close-btn" id="close-booking-modal" aria-label="Close booking modal">
        <span>✕</span>
      </button>
    </div>

    <!-- Booking Form -->
    <form class="booking-form" id="court-booking-form">
      <!-- 1. Court Selection -->
      <div class="form-group">
        <label class="form-label">1. Choose Court Type</label>
        <div class="court-options-grid">
          <label class="court-option-card is-selected">
            <input type="radio" name="courtType" value="panoramic" data-rate="250000" checked class="sr-only court-radio" />
            <span class="court-option-name">Panoramic Indoor</span>
            <span class="court-option-specs">Full Glass • AC Lounge</span>
            <span class="court-option-price">Rp 250.000/hr</span>
          </label>

          <label class="court-option-card">
            <input type="radio" name="courtType" value="outdoor" data-rate="200000" class="sr-only court-radio" />
            <span class="court-option-name">Sunlit Outdoor</span>
            <span class="court-option-specs">Blue Turf • Open Air</span>
            <span class="court-option-price">Rp 200.000/hr</span>
          </label>

          <label class="court-option-card">
            <input type="radio" name="courtType" value="stadium" data-rate="350000" class="sr-only court-radio" />
            <span class="court-option-name">Center Stadium</span>
            <span class="court-option-specs">WPT Standard • Spectator Stand</span>
            <span class="court-option-price">Rp 350.000/hr</span>
          </label>
        </div>
      </div>

      <!-- 2. Date & Time -->
      <div class="form-row-dual">
        <div class="form-group">
          <label for="booking-date" class="form-label">2. Select Date</label>
          <input type="date" id="booking-date" class="form-input" required />
        </div>

        <div class="form-group">
          <label for="booking-duration" class="form-label">Duration</label>
          <select id="booking-duration" class="form-select">
            <option value="1">1.0 Hour Session</option>
            <option value="1.5">1.5 Hours Session</option>
            <option value="2">2.0 Hours Match</option>
          </select>
        </div>
      </div>

      <!-- Time Slots -->
      <div class="form-group">
        <label class="form-label">Available Time Slots</label>
        <div class="time-slots-wrap">
          <button type="button" class="slot-pill is-active" data-slot="08:00">08:00</button>
          <button type="button" class="slot-pill" data-slot="10:00">10:00</button>
          <button type="button" class="slot-pill" data-slot="16:00">16:00</button>
          <button type="button" class="slot-pill" data-slot="18:00">18:00</button>
          <button type="button" class="slot-pill" data-slot="20:00">20:00</button>
        </div>
      </div>

      <!-- 3. Add-ons Gear & Coaching -->
      <div class="form-group">
        <label class="form-label">3. Optional Add-ons</label>
        <div class="addons-grid">
          <label class="addon-checkbox-card">
            <input type="checkbox" id="addon-rackets" data-price="35000" class="addon-checkbox" />
            <div class="addon-info">
              <span class="addon-name">Pro Carbon Racket Rental</span>
              <span class="addon-price">+Rp 35.000</span>
            </div>
          </label>

          <label class="addon-checkbox-card">
            <input type="checkbox" id="addon-balls" data-price="65000" class="addon-checkbox" />
            <div class="addon-info">
              <span class="addon-name">New Can of 3 Padel Balls</span>
              <span class="addon-price">+Rp 65.000</span>
            </div>
          </label>

          <label class="addon-checkbox-card">
            <input type="checkbox" id="addon-coach" data-price="150000" class="addon-checkbox" />
            <div class="addon-info">
              <span class="addon-name">Certified Coach Partner</span>
              <span class="addon-price">+Rp 150.000</span>
            </div>
          </label>
        </div>
      </div>

      <!-- Dynamic Price Summary -->
      <div class="booking-summary-bar">
        <div class="summary-total-col">
          <span class="summary-label">Estimated Total</span>
          <span class="summary-price" id="booking-total-display">Rp 250.000</span>
        </div>
        
        <button type="submit" class="btn-neon submit-booking-btn" id="confirm-booking-btn">
          <span>Book via WhatsApp</span>
          <span>↗</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Success Notification Toast -->
<div class="booking-toast" id="booking-toast" role="alert" aria-live="assertive">
  <span class="toast-icon">✓</span>
  <span class="toast-msg">Reservation link generated! Redirecting to Club Concierge...</span>
</div>

<style>
  .booking-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(11, 18, 32, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .booking-modal-backdrop.is-visible {
    display: flex;
    opacity: 1;
  }

  .booking-modal-card {
    background: #ffffff;
    width: 100%;
    max-width: 640px;
    max-height: 90vh;
    overflow-y: auto;
    padding: clamp(24px, 4vw, 36px);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.3);
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .modal-header-titles {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .modal-main-title {
    color: var(--color-dark-panel);
  }

  .modal-close-btn {
    font-size: 1rem;
    font-weight: 700;
  }

  .booking-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-dark-panel);
  }

  /* Court Options Cards */
  .court-options-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .court-option-card {
    border: 2px solid var(--color-border-subtle);
    border-radius: var(--radius-card-xs);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    background: var(--color-surface-light);
  }

  .court-option-card:hover {
    border-color: var(--color-court-blue);
  }

  .court-option-card.is-selected {
    border-color: var(--color-court-blue);
    background: rgba(29, 78, 216, 0.04);
  }

  .court-option-name {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-dark-panel);
  }

  .court-option-specs {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .court-option-price {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--color-court-blue);
    margin-top: 6px;
  }

  /* Form Dual Row */
  .form-row-dual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-input, .form-select {
    padding: 10px 14px;
    border: 1px solid var(--color-border-subtle);
    border-radius: 12px;
    font-size: 0.88rem;
    color: var(--color-text-main);
    background: #ffffff;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .form-input:focus, .form-select:focus {
    border-color: var(--color-court-blue);
    box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.12);
  }

  /* Time Slot Pills */
  .time-slots-wrap {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .slot-pill {
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: var(--color-surface-card);
    border: 1px solid var(--color-border-subtle);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-dark-panel);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .slot-pill.is-active {
    background: var(--color-dark-panel);
    color: #ffffff;
    border-color: var(--color-dark-panel);
  }

  /* Addons Grid */
  .addons-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .addon-checkbox-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border: 1px solid var(--color-border-subtle);
    border-radius: 12px;
    background: var(--color-surface-light);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .addon-checkbox-card:hover {
    border-color: var(--color-court-blue);
  }

  .addon-info {
    display: flex;
    justify-content: space-between;
    width: 100%;
    align-items: center;
  }

  .addon-name {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-dark-panel);
  }

  .addon-price {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-court-blue);
  }

  /* Summary Bar */
  .booking-summary-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid var(--color-border-subtle);
    margin-top: 8px;
  }

  .summary-total-col {
    display: flex;
    flex-direction: column;
  }

  .summary-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .summary-price {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--color-court-blue);
  }

  .submit-booking-btn {
    padding: 12px 24px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  /* Toast */
  .booking-toast {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background: var(--color-dark-panel);
    color: #ffffff;
    padding: 14px 22px;
    border-radius: var(--radius-pill);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.3);
    display: none;
    align-items: center;
    gap: 12px;
    z-index: 2000;
    font-size: 0.88rem;
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .booking-toast.is-active {
    display: flex;
    animation: toastPop 0.3s ease;
  }

  .toast-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-neon);
    color: var(--color-dark-panel);
    font-weight: 800;
    font-size: 0.8rem;
  }

  @keyframes toastPop {
    from {
      transform: translateY(20px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (max-width: 600px) {
    .court-options-grid {
      grid-template-columns: 1fr;
    }
    .form-row-dual {
      grid-template-columns: 1fr;
    }
    .booking-summary-bar {
      flex-direction: column;
      gap: 16px;
      align-items: stretch;
    }
    .submit-booking-btn {
      width: 100%;
    }
  }
</style>
