---
// Footer Component for Vortex Padel Club
---

<footer class="site-footer" id="contact">
  <div class="container footer-container">
    <div class="footer-card card-rounded">
      <!-- Giant Display Watermark -->
      <div class="footer-watermark" aria-hidden="true">
        LET'S TALK
      </div>

      <!-- Main Footer Content -->
      <div class="footer-grid">
        <!-- Left Side: Brand, Socials, Info & Newsletter -->
        <div class="footer-info-col">
          <!-- Social Media Links -->
          <div class="footer-social-row">
            <a href="#" class="social-icon-btn" aria-label="Facebook">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
            </a>
            <a href="#" class="social-icon-btn" aria-label="Instagram">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href="#" class="social-icon-btn" aria-label="YouTube">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
            <a href="#" class="social-icon-btn" aria-label="LinkedIn">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
          </div>

          <!-- Address & Hours Contacts -->
          <div class="footer-contact-details">
            <div class="contact-block">
              <span class="contact-label">Address</span>
              <p class="contact-value">Vortex Arena, Sunset Blvd No. 88, Bali & Jakarta</p>
            </div>
            <div class="contact-block">
              <span class="contact-label">Open Daily</span>
              <p class="contact-value">06:00 – 23:00 WIB (Mon–Sun)</p>
            </div>
            <div class="contact-block">
              <span class="contact-label">Phone & Booking</span>
              <p class="contact-value">+62 812-8899-7722</p>
            </div>
          </div>

          <!-- Newsletter Signup Bar -->
          <form class="footer-newsletter-form" id="newsletter-form">
            <input 
              type="email" 
              placeholder="Enter your email address..." 
              required 
              aria-label="Email for tournament updates"
              class="newsletter-input" 
              id="newsletter-email"
            />
            <button type="submit" class="btn-neon newsletter-submit-btn">
              <span>Submit</span>
              <span>↗</span>
            </button>
          </form>
        </div>

        <!-- Right Side: Visual Vignette Card -->
        <div class="footer-visual-col">
          <div class="footer-visual-card card-rounded">
            <img 
              src="https://images.unsplash.com/photo-1658723826297-fe4d1b1e6600?auto=format&fit=crop&w=700&q=80" 
              alt="Padel match equipment and court"
              class="footer-card-img" 
              loading="lazy"
            />
            <div class="footer-visual-overlay">
              <span class="badge-pill badge-pill-neon">Live Court Status</span>
              <p class="footer-visual-text">12 Courts Ready • Floodlights On</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Legal Sub-bar -->
      <div class="footer-legal-bar">
        <div class="legal-links">
          <a href="#" class="legal-link">Privacy Policy</a>
          <a href="#" class="legal-link">Terms And Conditions</a>
          <a href="#" class="legal-link">About Us</a>
          <a href="#" class="legal-link">FAQ</a>
        </div>
        <p class="copyright-text">
          &copy; 2026 Vortex Padel Club. All rights reserved. Built with passion for Padel.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-bottom: 32px;
  }

  .footer-card {
    background: var(--color-dark-panel);
    color: #ffffff;
    padding: clamp(32px, 6vw, 64px);
    position: relative;
    overflow: hidden;
  }

  /* Giant Watermark */
  .footer-watermark {
    font-size: clamp(3rem, 12vw, 10rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: rgba(255, 255, 255, 0.05);
    user-select: none;
    pointer-events: none;
    margin-bottom: 24px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .footer-info-col {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .footer-social-row {
    display: flex;
    gap: 14px;
  }

  .social-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    transition: all 0.2s ease;
  }

  .social-icon-btn:hover {
    background: var(--color-neon);
    color: var(--color-dark-panel);
    transform: translateY(-2px);
  }

  .footer-contact-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
  }

  .contact-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted-dark);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }

  .contact-value {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.4;
  }

  /* Newsletter Bar */
  .footer-newsletter-form {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-pill);
    padding: 6px 8px 6px 18px;
    max-width: 460px;
    transition: all 0.2s ease;
  }

  .footer-newsletter-form:focus-within {
    border-color: var(--color-neon);
    box-shadow: 0 0 0 3px rgba(212, 247, 44, 0.2);
  }

  .newsletter-input {
    border: none;
    background: transparent;
    outline: none;
    color: #ffffff;
    font-size: 0.88rem;
    flex: 1;
  }

  .newsletter-input::placeholder {
    color: var(--color-text-muted-dark);
  }

  .newsletter-submit-btn {
    padding: 8px 18px;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  /* Visual Vignette */
  .footer-visual-card {
    position: relative;
    height: 240px;
    overflow: hidden;
  }

  .footer-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .footer-visual-overlay {
    position: absolute;
    inset: 0;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(180deg, rgba(11, 18, 32, 0.3) 0%, rgba(11, 18, 32, 0.85) 100%);
  }

  .footer-visual-text {
    font-size: 0.9rem;
    font-weight: 600;
    color: #ffffff;
  }

  /* Legal Bar */
  .footer-legal-bar {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .legal-links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .legal-link {
    font-size: 0.8rem;
    color: var(--color-text-muted-dark);
    transition: color 0.2s ease;
  }

  .legal-link:hover {
    color: var(--color-neon);
  }

  .copyright-text {
    font-size: 0.8rem;
    color: var(--color-text-muted-dark);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-visual-card {
      display: none;
    }
  }
</style>
