---
// Facilities Section Component for Vortex Padel Club
---

<section class="facilities-section" id="facilities">
  <div class="container facilities-container">
    <!-- Header with Search & View All -->
    <div class="facilities-header">
      <h2 class="facilities-title title-h2">Explore Our Facilities</h2>
      
      <div class="facilities-controls">
        <!-- Facility Search Filter -->
        <div class="facility-search-pill">
          <input 
            type="text" 
            placeholder="Search facility..." 
            aria-label="Search club facilities" 
            class="facility-search-input"
            id="facility-filter-input"
          />
          <button type="button" class="facility-search-btn" aria-label="Search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
        </div>

        <!-- View All Button -->
        <button type="button" class="btn-primary-dark view-all-btn" id="filter-all-facilities">
          <span>View all</span>
          <span class="arrow-icon">↗</span>
        </button>
      </div>
    </div>

    <!-- 4-Card Facility Grid / Carousel -->
    <div class="facilities-grid" id="facilities-track">
      <!-- Card 1: Padel Court -->
      <div class="facility-card card-rounded" data-category="courts">
        <img 
          src="https://images.unsplash.com/photo-1658723826297-fe4d1b1e6600?auto=format&fit=crop&w=600&q=80" 
          alt="Professional blue padel court turf and balls"
          class="facility-img" 
          loading="lazy"
        />
        <div class="facility-overlay">
          <span class="badge-pill badge-pill-glass facility-badge">Padel Court</span>
          <p class="facility-caption">
            Professionally Designed Courts For Every Skill Level
          </p>
        </div>
      </div>

      <!-- Card 2: Lounge & Cafe -->
      <div class="facility-card card-rounded" data-category="lounge">
        <img 
          src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=600&q=80" 
          alt="Cozy social lounge and artisan cafe"
          class="facility-img" 
          loading="lazy"
        />
        <div class="facility-overlay">
          <span class="badge-pill badge-pill-glass facility-badge">Lounge & Cafe</span>
          <p class="facility-caption">
            Relax After Play In Our Cozy Lounge & Café
          </p>
        </div>
      </div>

      <!-- Card 3: Fitness Zone -->
      <div class="facility-card card-rounded" data-category="gym">
        <img 
          src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=600&q=80" 
          alt="Modern athletic strength and conditioning gym"
          class="facility-img" 
          loading="lazy"
        />
        <div class="facility-overlay">
          <span class="badge-pill badge-pill-glass facility-badge">Fitness Zone</span>
          <p class="facility-caption">
            Train, Prepare, and Build Endurance In Our Modern Gym
          </p>
        </div>
      </div>

      <!-- Card 4: Events & Tournaments -->
      <div class="facility-card card-rounded" data-category="events">
        <img 
          src="https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=600&q=80" 
          alt="Night tournament court with audience seating"
          class="facility-img" 
          loading="lazy"
        />
        <div class="facility-overlay">
          <span class="badge-pill badge-pill-glass facility-badge">Events & Tournaments</span>
          <p class="facility-caption">
            Join Friendly Matches and Official Tournaments
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Controls & Supporting Copy -->
    <div class="facilities-footer">
      <div class="carousel-arrows">
        <button type="button" class="btn-circle-mini" aria-label="Previous facility" id="fac-prev-btn">
          <span>‹</span>
        </button>
        <button type="button" class="btn-circle-mini" aria-label="Next facility" id="fac-next-btn">
          <span>›</span>
        </button>
      </div>

      <p class="facilities-bottom-copy">
        Book a court for training, friendly matches, or private coaching and discover a new level of padel in a welcoming atmosphere.
      </p>
    </div>
  </div>
</section>

<style>
  .facilities-section {
    padding-block: var(--section-spacing);
    background-color: var(--color-surface-light);
  }

  .facilities-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }

  .facilities-title {
    color: var(--color-dark-panel);
  }

  .facilities-controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .facility-search-pill {
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    padding: 8px 10px 8px 16px;
    gap: 8px;
    box-shadow: var(--shadow-sm);
    transition: all 0.2s ease;
  }

  .facility-search-pill:focus-within {
    border-color: var(--color-court-blue);
    box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.15);
  }

  .facility-search-input {
    border: none;
    background: transparent;
    outline: none;
    font-size: 0.85rem;
    width: 140px;
    color: var(--color-text-main);
  }

  .facility-search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-surface-card);
    color: var(--color-text-muted);
  }

  .view-all-btn {
    padding: 10px 18px;
    font-size: 0.82rem;
  }

  /* 4-Card Grid */
  .facilities-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 28px;
  }

  .facility-card {
    position: relative;
    height: 380px;
    box-shadow: var(--shadow-md);
  }

  .facility-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .facility-card:hover .facility-img {
    transform: scale(1.06);
  }

  .facility-overlay {
    position: absolute;
    inset: 0;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(180deg, rgba(11, 18, 32, 0.35) 0%, rgba(11, 18, 32, 0.1) 40%, rgba(11, 18, 32, 0.85) 100%);
  }

  .facility-badge {
    align-self: flex-start;
  }

  .facility-caption {
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  /* Footer Controls & Copy */
  .facilities-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .carousel-arrows {
    display: flex;
    gap: 10px;
  }

  .facilities-bottom-copy {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    max-width: 480px;
    line-height: 1.5;
  }

  @media (max-width: 1100px) {
    .facilities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .facilities-grid {
      grid-template-columns: 1fr;
    }
    .facility-card {
      height: 320px;
    }
    .facilities-footer {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }
</style>
