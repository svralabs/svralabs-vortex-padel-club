---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "VORTEX PADEL CLUB — Modern Panoramic Courts & Social Sanctuary",
  description = "Experience modern padel with panoramic glass courts, pro coaching, vibrant community, and instant court booking at Vortex Padel Club."
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d4ed8" />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <!-- Google Fonts Preconnect & Load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,700&display=swap" rel="stylesheet" />

    <!-- Favicon: Clean SVG Padel Racket & Ball Icon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='14' fill='%231d4ed8'/><circle cx='21' cy='11' r='4' fill='%23d4f72c'/><circle cx='13' cy='18' r='7' fill='none' stroke='white' stroke-width='2.5'/><line x1='8' y1='23' x2='4' y2='27' stroke='white' stroke-width='3' stroke-linecap='round'/></svg>" />
  </head>
  <body>
    <slot />
    
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
