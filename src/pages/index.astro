---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import AboutClub from '../components/AboutClub.astro';
import Experience from '../components/Experience.astro';
import Facilities from '../components/Facilities.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
import BookingModal from '../components/BookingModal.astro';
---

<BaseLayout 
  title="VORTEX PADEL CLUB — Modern Panoramic Courts & Social Sanctuary"
  description="Elevate your padel game with panoramic glass courts, pro coaching, vibrant community, and instant court booking at Vortex Padel Club."
>
  <main class="page-wrapper">
    <Navbar />
    <Hero />
    <AboutClub />
    <Experience />
    <Facilities />
    <Testimonials />
    <CtaBanner />
    <Footer />
  </main>

  <!-- Interactive Reservation Modal -->
  <BookingModal />
</BaseLayout>

<style>
  .page-wrapper {
    position: relative;
    width: 100%;
    overflow-x: hidden;
  }
</style>
